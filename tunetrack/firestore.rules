rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // USER PROFILE
    match /users/{userId} {
      // User hanya boleh membaca profile miliknya sendiri
      allow read: if request.auth != null
                   && request.auth.uid == userId;

      // User hanya boleh membuat profile dengan UID miliknya sendiri
      allow create: if request.auth != null
                    && request.auth.uid == userId;

      // User hanya boleh mengubah profile miliknya sendiri
      // dan tidak boleh mengganti UID pemiliknya
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && resource.data.uid == userId;

      // User boleh menghapus profile miliknya sendiri
      allow delete: if request.auth != null
                    && request.auth.uid == userId;

      // ACTIVE SESSIONS
      // Sessions are always stored under the authenticated user's UID.
      // The parent /users/{userId} path is therefore the ownership boundary.
      match /sessions/{sessionId} {
        // A user may read only sessions belonging to their own account.
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        // A session must be created with the authenticated user's UID.
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.uid == userId
                      && request.resource.data.sessionId == sessionId;

        // A user may update only their own session and may not transfer ownership.
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.uid == userId
                      && request.resource.data.uid == userId
                      && request.resource.data.sessionId == sessionId;

        // A user may remove only their own session.
        allow delete: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.uid == userId;
      }

      // USER NOTIFICATIONS
      match /notifications/{notificationId} {
        // User hanya boleh membaca notification miliknya sendiri
        allow read: if request.auth != null
                    && request.auth.uid == userId;

        // Untuk sekarang notification dibuat hanya di bawah UID user yang sedang login
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.uid == userId;

        // User hanya boleh menandai notification miliknya sebagai read/unread.
        // UID pemilik tidak boleh berubah.
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.uid == userId
                      && request.resource.data.uid == userId
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);

        allow delete: if request.auth != null
                      && request.auth.uid == userId
                      && resource.data.uid == userId;
      }
    }

    // DEFAULT: TUTUP SEMUA YANG BELUM KITA DEFINISIKAN
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
